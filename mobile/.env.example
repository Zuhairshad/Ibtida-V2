# Copy to .env. Leave both empty to run the app fully offline (local-only, sample community data).
# Use the project's *publishable* key (sb_publishable_...) or the legacy anon key — never service_role.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
