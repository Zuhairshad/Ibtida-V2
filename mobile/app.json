{
  "expo": {
    "name": "Ibtida",
    "slug": "ibtida",
    "scheme": "ibtida",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#16171D",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16171D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.ibtida",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ibtida uses your location on-device to calculate prayer times and the Qibla direction."
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "app.ibtida",
      "adaptiveIcon": {
        "backgroundColor": "#16171D",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#16171D",
          "imageWidth": 180
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ibtida uses your location on-device to calculate prayer times and the Qibla direction."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ibtida uses the camera only to scan your wudu-station and prayer-mat QR tags for the Fajr wake alarm. Nothing is recorded or uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F2A65A"
        }
      ],
      "./modules/ibadah-lock/plugin",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2fb38bc8-0231-4cb4-a3d2-03b791e750d2"
      }
    },
    "owner": "shad005"
  }
}
